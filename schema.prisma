generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" }

model Worker {
  id            String       @id @default(cuid())
  name          String
  employeeCode  String       @unique
  role          String       @default("WORKER")
  phone         String?
  status        String       @default("OFFLINE")
  lat           Float?
  lng           Float?
  altitudeM     Float?
  referenceM    Float?
  heartRate     Int?
  spo2          Float?
  temperatureC  Float?
  humidityPct   Float?
  batteryPct    Float?
  deviceId      String?
  shiftId       String?
  lastSeen      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  telemetry     Telemetry[]
  incidents     Incident[]
  shift         Shift?       @relation(fields: [shiftId], references: [id])
  @@index([status])
  @@index([lastSeen])
}

model Shift {
  id          String    @id @default(cuid())
  name        String
  siteName    String
  startsAt    DateTime
  endsAt      DateTime?
  status      String    @default("ACTIVE")
  workers     Worker[]
  createdAt   DateTime  @default(now())
}

model Telemetry {
  id            String   @id @default(cuid())
  workerId      String
  lat           Float
  lng           Float
  altitudeM     Float?
  accuracyM     Float?
  speedMps      Float?
  headingDeg    Float?
  heartRate     Int?
  spo2          Float?
  temperatureC  Float?
  humidityPct   Float?
  batteryPct    Float?
  source        String   @default("PHONE")
  createdAt     DateTime @default(now())
  worker        Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  @@index([workerId, createdAt])
  @@index([createdAt])
}

model Zone {
  id          String    @id @default(cuid())
  name        String
  kind        String    @default("RED")
  severity    String    @default("CRITICAL")
  polygon     Json
  enabled     Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  incidents   Incident[]
}

model Incident {
  id            String    @id @default(cuid())
  workerId      String?
  zoneId        String?
  type          String
  severity      String    @default("WARNING")
  status        String    @default("OPEN")
  message       String
  lat           Float?
  lng           Float?
  altitudeM     Float?
  weather       Json?
  screenshot    String?
  metadata      Json?
  acknowledgedAt DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  worker        Worker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)
  zone          Zone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([severity, status])
}

model Broadcast {
  id          String   @id @default(cuid())
  message     String
  sender      String   @default("ADMIN")
  priority    String   @default("NORMAL")
  target      String   @default("ALL")
  expiresAt   DateTime?
  acknowledgedBy Json?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String?
  entityId  String?
  payload   Json?
  ip        String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model Floorplan {
  id          String   @id @default(cuid())
  name        String
  imageUrl    String
  north       Float   @default(0)
  south       Float   @default(0)
  east        Float   @default(0)
  west        Float   @default(0)
  opacity     Float   @default(0.65)
  enabled     Boolean @default(true)
  createdAt   DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
